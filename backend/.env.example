# Copy to .env and adjust. server.ts loads .env if it exists.
NODE_ENV=development
PORT=4000

# MongoDB must be a replica set, because contact updates use transactions (ADR-002).
# MongoDB Atlas clusters, including the free M0 tier, are always replica sets.
# Put the database name (crm_dev) before the "?", otherwise Atlas uses a database called "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm_dev?retryWrites=true&w=majority
