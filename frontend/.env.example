# Optional. Copy to .env to point the dev-server proxy at a different API.
# Read by vite.config.ts only; never exposed to browser code.
API_PROXY_TARGET=http://localhost:4000

# Optional. Absolute API origin for builds served without the dev proxy,
# e.g. https://api.example.com. Leave unset in development.
# VITE_API_BASE_URL=
