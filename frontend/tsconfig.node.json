{
  // Build tooling and end-to-end tests (run in Node, not the browser).
  "compilerOptions": {
    "target": "ES2023",
    // DOM: e2e tests pass callbacks that run inside the browser (page.evaluate).
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
